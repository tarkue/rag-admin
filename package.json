{
  "name": "rag-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev:qa": "RAG_API_URL=http://127.0.0.1:4900/rag RAG_ADMIN_TOKEN=qa-admin-token RAG_SERVICE_TOKEN=qa-service-token NEXT_BUILD_DIR=.next-qa next dev --webpack --hostname 127.0.0.1 --port 3002",
