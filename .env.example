# Одна учётная запись администратора. Меняйте значения здесь, без правок кода.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=
# false для локального HTTP, true для HTTPS
COOKIE_SECURE=false

# Только серверные переменные — без NEXT_PUBLIC_
RAG_API_URL=http://127.0.0.1:8000
RAG_ADMIN_TOKEN=
RAG_SERVICE_TOKEN=
